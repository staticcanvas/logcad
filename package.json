{
    "name": "@staticcanvas/logcad",
    "version": "0.2.1",
    "description": "Utility to log styled messages to the console.",
    "main": "dist/logcad.js",
    "module": "dist/logcad.esm.js",
    "jsdelivr": "dist/logcad.min.js",
    "scripts": {
        "build": "rollup -c rollup.config.js",
        "build:dev": "rollup -c rollup.config.js --environment NODE_ENV:development",
        "watch": "rollup -c rollup.config.js --watch",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "prepublishOnly": "npm run build",
        "serve:example": "npm run build  && http-server examples -p 8080",
        "publish:npm": "echo //registry.npmjs.org/:_authToken=${NPM_API_KEY} > .npmrc && npm publish --access public"
    },
    "type": "module",
    "keywords": [
        "log",
        "message",
        "static-site",
        "debug",
        "color",
        "logging",
        "javascript",
        "es6"
    ],
    "author": {
        "name": "Garvey K. Snow",
        "email": "sgkens@gmail.com",
        "url": "https://gitlab.com/staticcanvas/logcad"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/staticcanvas/logcad.git"
    },
    "bugs": {
        "url": "https://gitlab.com/staticcanvas/logcad/issues"
    },
    "homepage": "https://gitlab.com/staticcanvas/logcad#readme",
    "files": [
        "dist/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {

    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.1",
        "@rollup/plugin-node-resolve": "^15.3.0",
        "@rollup/plugin-terser": "^0.4.4",
        "eslint": "^9.17.0",
        "http-server": "^14.1.1",
        "jest": "^29.7.0",
        "rollup": "^4.28.1",
        "jest-environment-jsdom": "^29.7.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "browserslist": [
        "defaults",
        "not ie < 11"
    ]
}